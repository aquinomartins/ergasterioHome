{
  "name": "ergasterio-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sync": "node --use-env-proxy --use-system-ca scripts/sync-repositories.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests config development.html playwright*.config.js vite.config.js package.json ergasterio-projects.json README.md .github/workflows/*.yml",
    "build:hosting": "vite build --mode hosting",
    "package:hosting": "npm run build:hosting && node scripts/package-hosting.mjs",
    "test:hosting": "npm run build:hosting && playwright test --config playwright.hosting.config.js",
    "test:root": "playwright test --config playwright.root.config.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
