{
  "name": "ergasterio-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sync": "node --use-env-proxy --use-system-ca scripts/sync-repositories.mjs",
    "test": "node --test tests/catalog.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests config index.html playwright.config.js package.json README.md .github/workflows/sync-catalog.yml"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "^3.6.2",
    "vite": "8.3.4"
  }
}
